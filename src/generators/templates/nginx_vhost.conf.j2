# ForgeOS vhost: {{ v.name }} -> {{ v.upstream_scheme }}://{{ v.upstream_host }}:{{ v.upstream_port }}
# GENERATED, do not edit by hand. Source: /etc/forgeos/config.json
{% macro proxy_body(v) %}
    location / {
        proxy_pass {{ v.upstream_scheme }}://forgeos_{{ v.name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{ v.proxy_read_timeout }}s;
{% if v.websocket %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
{% if v.allow_ips %}
{% for ip in v.allow_ips %}
        allow {{ ip }};
{% endfor %}
        deny all;
{% elif v.deny_ips %}
{% for ip in v.deny_ips %}
        deny {{ ip }};
{% endfor %}
{% endif %}
    }
{% endmacro %}
upstream forgeos_{{ v.name }} {
    server {{ v.upstream_host }}:{{ v.upstream_port }};
    keepalive 32;
}

server {
    listen 80{% if is_default %} default_server{% endif %};
    listen [::]:80{% if is_default %} default_server{% endif %};
    server_name {{ v.domain }}{% if is_default %} _{% endif %};
{% if v.force_ssl %}
    return 301 https://$host$request_uri;
{% else %}
    client_max_body_size {{ v.client_max_body_size }};
    access_log /var/log/nginx/{{ v.name }}-access.log;
    error_log  /var/log/nginx/{{ v.name }}-error.log warn;
{{ proxy_body(v) }}
{% endif %}
}

server {
    listen 443 ssl{% if is_default %} default_server{% endif %};
    listen [::]:443 ssl{% if is_default %} default_server{% endif %};
{% if v.http2 %}
    http2 on;
{% endif %}
    server_name {{ v.domain }}{% if is_default %} _{% endif %};

    ssl_certificate     {{ cert_path }};
    ssl_certificate_key {{ key_path }};
{% if v.hsts %}
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;
{% endif %}
    client_max_body_size {{ v.client_max_body_size }};
{% if v.gzip %}
    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript application/xml text/xml text/javascript;
{% endif %}
{% if v.block_common_exploits %}
    # Block common exploit patterns
    if ($request_uri ~* "(<|%3C).*script.*(>|%3E)") { return 403; }
    if ($request_uri ~* "\.\./") { return 403; }
    if ($query_string ~* "(;|'|%22).*(union|select|insert|drop|update|benchmark)") { return 403; }
{% endif %}

    access_log /var/log/nginx/{{ v.name }}-access.log;
    error_log  /var/log/nginx/{{ v.name }}-error.log warn;
{{ proxy_body(v) }}
    location /_forgeos_health {
        allow 127.0.0.1;
        deny all;
        return 200 "ok";
    }
{% if v.custom_snippet %}
    # --- custom configuration (admin-provided) ---
    {{ v.custom_snippet | indent(4) }}
{% endif %}
}
