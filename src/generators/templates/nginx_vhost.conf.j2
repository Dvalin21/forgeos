# ForgeOS vhost: {{ v.name }} -> 127.0.0.1:{{ v.upstream_port }}
# GENERATED, do not edit by hand. Source: /etc/forgeos/config.json
upstream forgeos_{{ v.name }} {
    server 127.0.0.1:{{ v.upstream_port }};
    keepalive 32;
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{ v.domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ v.domain }};

    ssl_certificate     {{ cert_path }};
    ssl_certificate_key {{ key_path }};

    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    access_log /var/log/nginx/{{ v.name }}-access.log;
    error_log  /var/log/nginx/{{ v.name }}-error.log warn;

    location / {
        proxy_pass http://forgeos_{{ v.name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if v.websocket %}
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
    }

    location /_forgeos_health {
        allow 127.0.0.1;
        deny all;
        return 200 "ok";
    }
}
